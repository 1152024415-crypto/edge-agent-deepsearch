{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edge_agent paper frontmatter",
  "description": "content/papers/*.md 顶部 YAML frontmatter 的字段规范。agent 产出论文分析后由 harness 层映射为此结构。",
  "type": "object",
  "required": ["id", "slug", "title", "authors", "source_type", "date", "url", "score", "recommendation"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "唯一标识，去重用（建议 vendor-date-slug）" },
    "slug": { "type": "string", "minLength": 1, "description": "URL slug" },
    "title": { "type": "string", "minLength": 1 },
    "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "affiliations": { "type": "array", "items": { "type": "string" }, "description": "作者机构（用于白名单匹配）" },
    "source_type": { "type": "string", "enum": ["学术论文", "厂商博客", "GitHub", "产品发布"] },
    "date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
    "url": { "type": "string", "format": "uri" },
    "branches": { "type": "array", "items": { "type": "string" }, "description": "技术分支（README 第五节）" },
    "vendors": { "type": "array", "items": { "type": "string" }, "description": "关联大厂 name（见 data/vendors.yaml）" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "综合评分，应等于下 6 维之和" },
    "score_relevance": { "type": "integer", "minimum": 0, "maximum": 30, "description": "主题契合度（30%）" },
    "score_vendor": { "type": "integer", "minimum": 0, "maximum": 25, "description": "大厂关联度（25%）" },
    "score_contribution": { "type": "integer", "minimum": 0, "maximum": 15, "description": "技术贡献度（15%）" },
    "score_quality": { "type": "integer", "minimum": 0, "maximum": 15, "description": "信息质量（15%）" },
    "score_recency": { "type": "integer", "minimum": 0, "maximum": 5, "description": "时效新鲜度（5%）" },
    "score_open": { "type": "integer", "minimum": 0, "maximum": 10, "description": "开源评分（10%）：有开源仓库/数据集/模型开源 5-10，不开源 0" },
    "recommendation": { "type": "string", "enum": ["纳入", "纳入待复审", "排除"] },
    "review_hint": { "type": "string", "description": "人工复审重点方向" },
    "insight_person": { "type": "string", "description": "洞察人 / 负责分析的 agent 或人" },
    "wiki_url": { "type": "string", "format": "uri", "description": "对应 wiki 页面链接" }
  },
  "additionalProperties": false
}
